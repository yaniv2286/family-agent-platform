lugassy-agents.duckdns.org {
    handle_path /api/koko/* {
        rewrite * /api{uri}
        reverse_proxy koko-backend:8000
    }

    redir /mikey /mikey/ 308

    handle_path /mikey/* {
        root * /srv/mikey
        try_files {path} /index.html
        file_server
    }

